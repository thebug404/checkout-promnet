{
  "name": "remix-auth-keycloak",
  "version": "0.1.0",
  "description": "Keycloak strategy for Remix Auth based on remix-auth-oauth2",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "remix-auth-oauth2": "^3.4.1"
  },
  "peerDependencies": {
    "remix-auth": "^4.2.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
